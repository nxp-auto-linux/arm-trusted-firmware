#include "s32r47.dtsi"
#if (S32R47_W_S32R45 == 1)
#include "s32r47_w_r45.dtsi"
#endif
#include "s32r47-nxp-flash-micron.dtsi"

/ {
	model = "NXP S32R478AEVB";
	compatible = "nxp,s32r47";
};

&qspi {
	status = "okay";
};

&gmac1_mdio {
	#address-cells = <1>;
	#size-cells = <0>;

	/* TJA1120B */
	mdio_gmac1_phy4: ethernet-phy@4 {
		reg = <4>;
	};
};

&gmac2_mdio {
	#address-cells = <1>;
	#size-cells = <0>;

	/* TJA1120B */
	mdio_gmac2_phy1: ethernet-phy@1 {
		reg = <1>;
	};
};

&pit1 {
	status = "okay";
};

&uart0 {
	status = "okay";
};
