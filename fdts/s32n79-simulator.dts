/dts-v1/;
#include "s32n79.dtsi"

/ {
	model = "NXP S32N79-SIM";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0 0x80000000 0 0x80000000>;
	};

	clocks {
		sys_clk: sys_clk {
			compatible = "fixed-clock";
			clock-frequency = <100000000>;
			#clock-cells = <0>;
		};
	};
};

&uart0 {
	status = "okay";
};

&ufshc {
	status = "okay";
};

&usdhc0 {
	status = "okay";
};

&spi0 {
	status = "okay";
};

&spi1 {
	status = "okay";
};

&spi2 {
	status = "okay";
};

&spi3 {
	status = "okay";
};

&spi4 {
	status = "okay";
};

&spi5 {
	status = "okay";
};

&lpi2c0 {
	status = "okay";
};

&lpi2c1 {
	status = "okay";
};

&lpi2c2 {
	status = "okay";
};

&lpi2c3 {
	status = "okay";
};

&lpi2c4 {
	status = "okay";
};

&lpi2c5 {
	status = "okay";
};

&xspi0 {
	nxp,xspi-env = <0>;
	nxp,xspi-gmid;
	status = "okay";

	s28hs512t: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <200000000>;
		spi-tx-bus-width = <8>;
		spi-rx-bus-width = <8>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/*
			 * By default, s28hs512t/s28hs01gt have a bottom hybrid
			 * configuration:
			 * - address range [0x0 - 0x1ffff] - 32 sectors
			 * of 4KB size
			 * - address range [0x20000 - 0x3ffff] - 1 sector of
			 * 128KB size
			 * - address range [0x3ffff - ...] - 256KB sectors
			 * The XSPI partitions should be defined taking into
			 * account the flash address space configuration.
			 */
			flashimage@0 {
				label = "Flash-Image";
				reg = <0x0 0x4000000>;
			};
		};
	};
};
