/*
 * Device Tree Include file for NXP S32N79 SoC.
 *
 * Copyright 2024-2025 NXP
 */

#include <dt-bindings/interrupt-controller/arm-gic.h>

/ {
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		serial0 = &uart0;
		mmc0 = &usdhc0;
		spi0 = &spi0;
		spi1 = &spi1;
		spi2 = &spi2;
		spi3 = &spi3;
		spi4 = &spi4;
		spi5 = &spi5;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		scmi_shbuf: shm@d0000000 {
			compatible = "arm,scmi-shmem";
			reg = <0x0 0xd0000000 0x0 0x80>;
			no-map;
		};
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		u-boot,dm-pre-reloc;

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};

				core1 {
					cpu = <&cpu1>;
				};
			};
		};

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a78-ae";
			reg = <0x0>;
			enable-method = "psci";
			next-level-cache = <&l2_0>;
			u-boot,dm-pre-reloc;
		};

		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a78-ae";
			reg = <0x100>;
			enable-method = "psci";
			next-level-cache = <&l2_0>;
			u-boot,dm-pre-reloc;
		};

	};

	l2_0: l2-cache {
		compatible = "cache";
		cache-level = <2>;
		cache-size = <524288>;
		cache-line-size = <64>;
		cache-sets = <512>;
		next-level-cache = <&l3_0>;
	};

	l3_0: l3-cache {
		compatible = "cache";
		cache-level = <3>;
		cache-size = <1048576>;
		cache-line-size = <64>;
		cache-sets = <1024>;
	};

	firmware {
		u-boot,dm-pre-reloc;

		scmi: scmi {
			u-boot,dm-pre-reloc;
			compatible = "arm,scmi-smc";
			shmem = <&scmi_shbuf>;
			arm,smc-id = <0xc2000000>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";
		};

		psci {
			compatible = "arm,psci-1.0";
			method = "smc";
		};
	};

	cis_subsys {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x0 0x0 0x20000000>,
			 <0x4f200000 0x0 0x4f200000 0xc00000>;

		gic: interrupt-controller@4f200000 {
			compatible = "arm,gic-v3";
			#address-cells = <1>;
			#size-cells = <1>;
			#interrupt-cells = <3>;
			interrupt-controller;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x4f200000 0x10000>, /* GIC Dist */
			      <0x4f260000 0x100000>; /* GICR (RD_base + SGI_base) */
			ranges;

			its: msi-controller@4f240000 {
				compatible = "arm,gic-v3-its";
				reg = <0x4f240000 0x20000>;
				msi-controller;
			};
		};

	};

	coss_subsys {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x4a000000 0x0 0x4a000000 0xff0000>,
			 <0x4e000000 0x0 0x4e000000 0x1000000>;

		uart0: serial@4a030000 {
			compatible = "arm,pl011", "arm,primecell";
			reg = <0x4a030000 0x1000>;
			clocks = <&sys_clk>, <&sys_clk>;
			clock-names = "uartclk", "apb_pclk";
			status = "disabled";
		};

		ufs: ufs@4ac80000 {
			compatible = "nxp,s32n79-ufshc", "jedec,ufs-3.0";
			reg = <0x4ac80000 0x1000>;
			status = "disabled";
		};

		spi0: spi@4a070000 {
			compatible = "nxp,s32n79-dspi";
			reg = <0x4a070000 0x1000>;
			clocks = <&sys_clk>;
			clock-names = "dspi";
			spi-num-chipselects = <6>;
			bus-num = <0>;
			spi-fifo-size = <16>;
			spi-cpol;
			spi-cpha;
			status = "disabled";
		};

		spi1: spi@4a080000 {
			compatible = "nxp,s32n79-dspi";
			reg = <0x4a080000 0x1000>;
			clocks = <&sys_clk>;
			clock-names = "dspi";
			spi-num-chipselects = <6>;
			bus-num = <1>;
			spi-fifo-size = <16>;
			spi-cpol;
			spi-cpha;
			status = "disabled";
		};

		spi2: spi@4a090000 {
			compatible = "nxp,s32n79-dspi";
			reg = <0x4a090000 0x1000>;
			clocks = <&sys_clk>;
			clock-names = "dspi";
			spi-num-chipselects = <6>;
			bus-num = <2>;
			spi-fifo-size = <16>;
			spi-cpol;
			spi-cpha;
			status = "disabled";
		};

		spi3: spi@4aa70000 {
			compatible = "nxp,s32n79-dspi";
			reg = <0x4aa70000 0x1000>;
			clocks = <&sys_clk>;
			clock-names = "dspi";
			spi-num-chipselects = <6>;
			bus-num = <3>;
			spi-fifo-size = <16>;
			spi-cpol;
			spi-cpha;
			status = "disabled";
		};

		spi4: spi@4aa80000 {
			compatible = "nxp,s32n79-dspi";
			reg = <0x4aa80000 0x1000>;
			clocks = <&sys_clk>;
			clock-names = "dspi";
			spi-num-chipselects = <6>;
			bus-num = <4>;
			spi-fifo-size = <16>;
			spi-cpol;
			spi-cpha;
			status = "disabled";
		};

		spi5: spi@4aa90000 {
			compatible = "nxp,s32n79-dspi";
			reg = <0x4aa90000 0x1000>;
			clocks = <&sys_clk>;
			clock-names = "dspi";
			spi-num-chipselects = <3>;
			bus-num = <5>;
			spi-fifo-size = <16>;
			spi-cpol;
			spi-cpha;
			status = "disabled";
		};

		lpi2c0: i2c@4a0d0000 {
			compatible = "nxp,s32n79-lpi2c";
			reg = <0x4a0d0000 0x1000>;
			clocks = <&sys_clk>, <&sys_clk>;
			clock-names = "per", "ipg";
			status = "disabled";
		};

		lpi2c1: i2c@4a0e0000 {
			compatible = "nxp,s32n79-lpi2c";
			reg = <0x4a0e0000 0x1000>;
			clocks = <&sys_clk>, <&sys_clk>;
			clock-names = "per", "ipg";
			status = "disabled";
		};

		lpi2c2: i2c@4a0f0000 {
			compatible = "nxp,s32n79-lpi2c";
			reg = <0x4a0f0000 0x1000>;
			clocks = <&sys_clk>, <&sys_clk>;
			clock-names = "per", "ipg";
			status = "disabled";
		};

		lpi2c3: i2c@4aaa0000 {
			compatible = "nxp,s32n79-lpi2c";
			reg = <0x4aaa0000 0x1000>;
			clocks = <&sys_clk>, <&sys_clk>;
			clock-names = "per", "ipg";
			status = "disabled";
		};

		lpi2c4: i2c@4aab0000 {
			compatible = "nxp,s32n79-lpi2c";
			reg = <0x4aab0000 0x1000>;
			clocks = <&sys_clk>, <&sys_clk>;
			clock-names = "per", "ipg";
			status = "disabled";
		};

		lpi2c5: i2c@4aac0000 {
			compatible = "nxp,s32n79-lpi2c";
			reg = <0x4aac0000 0x1000>;
			clocks = <&sys_clk>, <&sys_clk>;
			clock-names = "per", "ipg";
			status = "disabled";
		};
	};

	fss_subsys {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x5b490000 0x0 0x5b490000 0x1000>;

		usdhc0: mmc@5b490000 {
			compatible = "nxp,s32n-usdhc";
			reg = <0x5b490000 0x1000>;
			clocks = <&sys_clk>, <&sys_clk>, <&sys_clk>;
			clock-names = "ipg", "ahb", "per";
			bus-width = <8>;
			clock-frequency = <0>;	/* updated dynamically if 0 */
			status = "disabled";
		};
	};

	nwss_subsys {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges = <0x0 0x48800000 0x0 0x48800000 0x0 0x540000>,
			 <0x2 0x40000000 0x2 0x40000000 0x0 0x2000000>;

		netc_iep: pcie@240000000 {
			compatible = "pci-host-ecam-generic";
			reg = <0x2 0x40000000 0x0 0x2000000>;
			#address-cells = <3>;
			#size-cells = <2>;
			device_type = "pci";

			ranges = <0x82000000 0x0 0x48800000 0x0 0x48800000 0x0 0x540000>;
		};
	};
};
