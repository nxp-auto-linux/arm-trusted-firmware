/dts-v1/;
#include "s32n79-simulator.dtsi"

/ {
	cpus {
		cpu-map {
			cluster1 {
				core0 {
					cpu = <&cpu0>;
				};

				core1 {
					cpu = <&cpu1>;
				};
			};
		};
	};
};

&uart0 {
	status = "okay";
};

&ufshc {
	status = "okay";
};

&usdhc0 {
	status = "okay";
};

&spi0 {
	status = "okay";
};

&spi1 {
	status = "okay";
};

&spi2 {
	status = "okay";
};

&spi3 {
	status = "okay";
};

&spi4 {
	status = "okay";
};

&spi5 {
	status = "okay";
};

&lpi2c0 {
	status = "okay";
};

&lpi2c1 {
	status = "okay";
};

&lpi2c2 {
	status = "okay";
};

&lpi2c3 {
	status = "okay";
};

&lpi2c4 {
	status = "okay";
};

&lpi2c5 {
	status = "okay";
};

&xspi0 {
	status = "okay";
};

&netc_iep {
	status = "okay";
};
